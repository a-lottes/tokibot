# USB gadget (network adapter on the data port)
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
# e-paper via SPI
CONFIG_SPI_BCM2835=y
CONFIG_SPI_SPIDEV=y
# Bluetooth LE for meeting other gotchis (modules, loaded by S40bluetooth once the
# root filesystem with the firmware is mounted)
CONFIG_BT=m
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
