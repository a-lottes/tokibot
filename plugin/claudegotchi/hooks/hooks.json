{
  "description": "Reports Claude Code events to the Claudegotchi (metadata only).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/claudegotchi.sh\" hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/claudegotchi.sh\" hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
